{
  "name": "glitch-editor",
  "version": "0.1.0",
  "description": "Editor de fotos glitch local que simula el circuit bending de una cámara",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
